{
  "name": "draw.ai",
  "productName": "draw.ai",
  "version": "0.1.3",
  "description": "Open-source AI diagram workspace based on draw.io",
  "exports": "./src/main/electron.js",
  "type": "module",
  "main": "src/main/electron.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron .",
    "sync": "node ./sync.cjs",
    "test": "node --test src/test/branding.test.js src/test/cli-args.test.js src/test/editor-default-view.test.js src/test/editor-tab-create.test.js src/test/msi-project-created.test.js src/test/user-data-migration.test.js src/test/window-bounds.test.js src/test/workspace-agent.test.js src/test/workspace-explorer.test.js src/test/workspace-files.test.js",
    "generate-icons": "node build/generate-icons.mjs",
    "release-win": "electron-builder --config electron-builder-win.json --publish always",
    "release-win32": "electron-builder --config electron-builder-win32.json --publish always",
    "release-win-arm64": "electron-builder --config electron-builder-win-arm64.json --publish always",
    "release-appx": "electron-builder --config electron-builder-appx.json --publish always",
    "release-linux": "electron-builder --config electron-builder-linux-mac.json --publish always",
    "release-snap": "electron-builder --config electron-builder-snap.json --publish never"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tangf-ai/draw.ai.git"
  },
  "keywords": [
    "draw.ai",
    "draw.io",
    "AI",
    "diagram",
    "flowchart",
    "UML"
  ],
  "author": "draw.ai contributors",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/tangf-ai/draw.ai/issues"
  },
  "homepage": "https://github.com/tangf-ai/draw.ai",
  "dependencies": {
    "@cantoo/pdf-lib": "^2.7.3",
    "@xmldom/xmldom": "^0.8.13",
    "buffer": "^6.0.3",
    "compression": "^1.8.1",
    "crc": "^4.3.2",
    "electron-context-menu": "^4.1.2",
    "electron-log": "^5.4.4",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@electron/notarize": "^3.1.1",
    "dotenv": "^17.4.2",
    "electron": "^42.8.0",
    "electron-builder": "^26.15.7",
    "quicklookjs": "^1.0.1",
    "sumchecker": "^3.0.1"
  }
}
