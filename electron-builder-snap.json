{
  "appId": "ai.draw.desktop",
  "copyright": "Copyright 2026 draw.ai contributors; portions Copyright 2017-2026 draw.io Ltd",
  "asar": true,
  "files": [
    "**/*",
    "!**/WEB-INF{,/**}",
    "!.github{,/**}",
    "!.gitmodules",
    "!build{,/**}",
    "!docs{,/**}",
    "!src/test{,/**}",
    "!README*.md",
    "!electron-builder-*.json",
    "!sync.cjs",
    "!drawio/src/main/webapp/js/integrate.min.js",
    "!drawio/src/main/webapp/js/viewer.min.js"
  ],
  "artifactName": "${productName}-${arch}-${version}.${ext}",
  "directories": {
    "output": "./dist/"
  },
  "npmRebuild": false,
  "linux": {
    "executableName": "draw-ai",
    "category": "Graphics",
    "maintainer": "draw.ai contributors",
    "icon": "./build",
    "desktop": {
      "entry": {
        "StartupWMClass": "draw-ai"
      }
    },
    "target": [
      "snap"
    ]
  },
  "snapcraft": {
    "base": "core24",
    "core24": {
      "useLXD": true,
      "plugs": [
        "default",
        "removable-media",
        "browser-support"
      ]
    }
  },
  "afterPack": "build/fuses.mjs",
  "fileAssociations": [
	  {
	  	"ext": "drawio",
	    "name": "draw.ai Diagram",
	    "description": "draw.ai Diagram",
	  	"mimeType": "application/vnd.jgraph.mxfile",
	  	"role": "Editor"
	  },
	  {
	  	"ext": "vsdx",
	  	"name": "VSDX Document",
	  	"description": "VSDX Document",
	  	"mimeType": "application/vnd.visio",
	  	"role": "Editor"
	  },
	  {
	  	"ext": ["mmd", "mermaid"],
	  	"name": "Mermaid Diagram",
	  	"description": "Mermaid Diagram",
	  	"mimeType": "text/vnd.mermaid",
	  	"role": "Editor"
	  }
  ]
}
