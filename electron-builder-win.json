{
  "appId": "ai.draw.desktop",
  "copyright": "Copyright 2026 draw.ai contributors; portions Copyright 2017-2026 draw.io Ltd",
  "asar": true,
  "files": [
    "**/*",
    "!**/WEB-INF{,/**}",
    "!.github{,/**}",
    "!.gitmodules",
    "!build{,/**}",
    "!docs{,/**}",
    "!src/test{,/**}",
    "!README*.md",
    "!electron-builder-*.json",
    "!sync.cjs"
  ],
  "directories": {
    "output": "./dist/"
  },
  "npmRebuild": false,
  "publish": {
      "provider": "github"
  },
  "win": {
    "target": [
      {
          "target": "nsis",
          "arch": [
            "x64"
          ]
      },
      {
        "target": "msi",
        "arch": [
          "x64"
        ]
      }
    ]
  },
  "nsis": {
    "artifactName": "${productName}-${version}-windows-installer.${ext}",
  	"oneClick": false,
    "perMachine": true,
    "allowToChangeInstallationDirectory": true,
    "runAfterFinish": false,
    "createDesktopShortcut": false
  },
  "msi": {
    "artifactName": "${productName}-${version}.${ext}",
    "runAfterFinish": false,
    "createDesktopShortcut": false
  },
  "afterPack": "build/fuses.mjs",
  "msiProjectCreated": "build/msi-project-created.mjs",
  "fileAssociations": [
	  {
	  	"ext": "drawio",
	    "name": "draw.ai Diagram",
	    "description": "draw.ai Diagram",
	  	"mimeType": "application/vnd.jgraph.mxfile",
	  	"role": "Editor"
	  },
	  {
	  	"ext": "vsdx",
	  	"name": "VSDX Document",
	  	"description": "VSDX Document",
	  	"mimeType": "application/vnd.visio",
	  	"role": "Editor"
	  },
	  {
	  	"ext": ["mmd", "mermaid"],
	  	"name": "Mermaid Diagram",
	  	"description": "Mermaid Diagram",
	  	"mimeType": "text/vnd.mermaid",
	  	"role": "Editor"
	  }
  ]
}
